{
  "schemaVersion": 1,
  "id": "mod_id",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contributors": [
  ],
  "contact": {
    "homepage": "https://iunius118.github.io/ChiliBulletWeapons/",
    "sources": "https://github.com/Iunius118/ChiliBulletWeapons",
    "issues": "https://github.com/Iunius118/ChiliBulletWeapons/issues"
  },
  "license": "${license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.github.iunius118.chilibulletweapons.ChiliBulletWeapons"
    ],
    "client": [
      "com.github.iunius118.chilibulletweapons.ChiliBulletWeaponsClient"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "accessWidener": "${mod_id}.accesswidener",
  "depends": {
    "fabricloader": ">=0.14",
    "fabric": "*",
    "cloth-config": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=17"
  },
  "suggests": {
    "another-mod": "*"
  }
}
